<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <context-param>
        <param-name>dbUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/REDACTED_DATABASE</param-value>
    </context-param>
    <context-param>
        <param-name>dbUser</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>dbPassword</param-name>
        <param-value>REDACTED_DATABASE_PASSWORD</param-value>
    </context-param>
    <context-param>
        <param-name>dbDriver</param-name>
        <param-value>com.mysql.cj.jdbc.Driver</param-value>
    </context-param>
   
    
    <filter>
		<filter-name>Checker</filter-name>
		<filter-class>it.polimi.tiw.filters.Checker</filter-class>
	</filter>
	
	<filter-mapping>
		<filter-name>Checker</filter-name>
		<url-pattern>/CreateDocument</url-pattern>
		<url-pattern>/CreateFolder</url-pattern>
		<url-pattern>/DeleteDocument</url-pattern>
		<url-pattern>/DeleteFolder</url-pattern>
		<url-pattern>/GetDocument</url-pattern>
		<url-pattern>/GetTree</url-pattern>
		<url-pattern>/GetVersionHistory</url-pattern>
		<url-pattern>/MoveDocument</url-pattern>
	</filter-mapping>
	
	<filter>
		<filter-name>LoggedOutChecker</filter-name>
		<filter-class>it.polimi.tiw.filters.LoggedOutChecker</filter-class>
	</filter>
	
	<filter-mapping>
		<filter-name>LoggedOutChecker</filter-name>
		<url-pattern>/CheckLoginCredentials</url-pattern>
		<url-pattern>/CheckSignupCredentials</url-pattern>
	</filter-mapping>
	
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>